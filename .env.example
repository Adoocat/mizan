# Copy to .env for local development. Never commit .env.
# These values are for the local Docker Postgres only (bound to 127.0.0.1).

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Local dev database from infra/docker-compose.yml
DATABASE_URL=postgres://mizan:mizan_local_dev@127.0.0.1:5433/mizan

# Connections the database pool may open. A single page load can hold several at once.
DATABASE_POOL_MAX=10

# Origin of the web app, used for CORS
WEB_ORIGIN=http://localhost:5173

# Set to true only when running behind a trusted reverse proxy
TRUST_PROXY=false

# Signs session cookies and hashes reset tokens: `openssl rand -base64 32`.
# Rotating it signs every user out. Never commit a real value.
AUTH_SECRET=replace-me-with-32-bytes-of-base64-randomness

# Rejects passwords found in the Have I Been Pwned corpus (an outbound HTTPS call).
# Set to false only when outbound network access is unwanted.
AUTH_BREACHED_PASSWORD_CHECK=true
