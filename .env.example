# Copy to .env for local development. Never commit .env.
# These values are for the local Docker Postgres only (bound to 127.0.0.1).

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Local dev database from infra/docker-compose.yml
DATABASE_URL=postgres://mizan:mizan_local_dev@127.0.0.1:5433/mizan

# Origin of the web app, used for CORS
WEB_ORIGIN=http://localhost:5173

# Set to true only when running behind a trusted reverse proxy
TRUST_PROXY=false
