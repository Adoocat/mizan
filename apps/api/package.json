{
  "name": "@mizan/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/main.ts",
    "start": "node src/main.ts",
    "worker": "node src/worker.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env src/db/migrate.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@mizan/contracts": "workspace:*",
    "@mizan/domain": "workspace:*",
    "@node-rs/argon2": "^2.2.1",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@mizan/config": "workspace:*",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "testcontainers": "^12.2.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
