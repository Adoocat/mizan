{
  "name": "mizan",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @mizan/api --filter @mizan/web dev",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm test:unit && pnpm test:int && pnpm test:e2e",
    "test:unit": "pnpm -r test:unit",
    "test:int": "pnpm --filter @mizan/api test:int",
    "test:e2e": "pnpm --filter @mizan/e2e test",
    "db:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:generate": "pnpm --filter @mizan/api db:generate",
    "db:migrate": "pnpm --filter @mizan/api db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mizan/config": "workspace:*",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
